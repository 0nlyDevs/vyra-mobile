<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <application>
    <!-- « Vyra » in the text-selection menu: checks the selected text. -->
    <activity
        android:name="expo.modules.vyratext.ProcessTextActivity"
        android:label="@string/vyra_menu_check"
        android:exported="true"
        android:excludeFromRecents="true"
        android:theme="@style/Theme.VyraSheet"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity>

    <!-- « Traduire FR ↔ MG »: on text being written, the translation replaces the selection. -->
    <activity-alias
        android:name="expo.modules.vyratext.TranslateText"
        android:targetActivity="expo.modules.vyratext.ProcessTextActivity"
        android:label="@string/vyra_menu_translate"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity-alias>

    <!-- « Remplacer par le démenti »: a rumour being written becomes the published démenti and its link. -->
    <activity-alias
        android:name="expo.modules.vyratext.DebunkText"
        android:targetActivity="expo.modules.vyratext.ProcessTextActivity"
        android:label="@string/vyra_menu_debunk"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.PROCESS_TEXT" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
      </intent-filter>
    </activity-alias>

    <!-- Tile, shortcut and widget button: the same sheet, opened on "check the clipboard". -->
    <activity
        android:name="expo.modules.vyratext.QuickCheckActivity"
        android:label="@string/vyra_tile"
        android:exported="false"
        android:taskAffinity=""
        android:excludeFromRecents="true"
        android:theme="@style/Theme.VyraSheet"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale" />

    <service
        android:name="expo.modules.vyratext.CheckTileService"
        android:label="@string/vyra_tile"
        android:icon="@drawable/vyra_stat"
        android:exported="true"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>

    <receiver
        android:name="expo.modules.vyratext.VerdictsWidget"
        android:label="@string/vyra_widget_title"
        android:exported="false">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/vyra_widget_info" />
    </receiver>

    <service
        android:name="expo.modules.vyratext.CheckWorkService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />
  </application>
</manifest>
